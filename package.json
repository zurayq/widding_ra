        "check:browser": "node scripts/review-master.mjs",
        "assets:optimize": "node scripts/optimize-assets.mjs"
    },
    "dependencies": {
        "gsap": "^3.15.0",
        "next": "^16.3.8",
        "react": "^19.3.0",
        "react-dom": "^19.3.0"
