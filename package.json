    "devDependencies": {
        "@types/node": "^26.6.4",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "playwright": "^1.63.0",
        "typescript": "^5.9.3",
        "sharp": "^0.35.5"
    }
}
